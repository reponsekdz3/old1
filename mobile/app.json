{
  "expo": {
    "name": "VipChat",
    "slug": "vipchat",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vipchat.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "VipChat needs camera access to scan QR codes and send photos.",
        "NSMicrophoneUsageDescription": "VipChat needs microphone access for voice messages and calls.",
        "NSPhotoLibraryUsageDescription": "VipChat needs photo library access to send images.",
        "NSPhotoLibraryAddUsageDescription": "VipChat needs to save images to your photo library.",
        "NSContactsUsageDescription": "VipChat needs access to your contacts to show which of your friends are on VipChat.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "package": "com.vipchat.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ],
      "blockedPermissions": [],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "VipChat needs camera access to scan QR codes and take photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "VipChat needs microphone access for voice messages and calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VipChat needs access to your photos to send images.",
          "cameraPermission": "VipChat needs camera access to take photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#25D366",
          "sounds": ["./assets/notification.wav", "./assets/ringtone.wav"]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "VipChat needs access to your contacts to show which of your friends are already on VipChat."
        }
      ]
    ],
    "scheme": "vipchat",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "vipchat"
  }
}
