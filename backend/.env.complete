# ═══════════════════════════════════════════════════════════════════════════
# BITESE - Complete Enterprise Integration Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
FLASK_ENV=production
DEBUG=false
ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Recommended for production - scales to billions of users)
DATABASE_URL=postgresql://bitese:your_secure_password@db.example.com:5432/bitese_prod

# Connection pooling for scalability
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (Required for E2EE key caching, sessions, and scalability)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:your_redis_password@redis.example.com:6379/0
REDIS_SENTINEL_ENABLED=false
REDIS_CLUSTER_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# JWT & SESSION SECURITY
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=your_256_bit_random_secret_key_minimum_32_characters_long_here
JWT_SECRET_KEY=your_256_bit_jwt_secret_minimum_32_characters_long_here

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION CONFIGURATION (Signal Protocol + Advanced E2EE)
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_MASTER_PASSWORD=your_strong_master_password_minimum_32_characters_here
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY_ROTATION_DAYS=90

# Signal Protocol Configuration
SIGNAL_PROTOCOL_VERSION=3
SIGNAL_MAX_FORWARD_JUMPS=5
E2EE_KEY_BUNDLE_EXPIRY_DAYS=7
E2EE_OTK_REFRESH_THRESHOLD=20
E2EE_OTK_PREGENERATE_COUNT=100
E2EE_FORCE_ON_MESSAGES=true

# ─────────────────────────────────────────────────────────────────────────────
# ADVANCED SECURITY
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
SECURITY_LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# TLS/SSL Certificates
TLS_CERT_PATH=/etc/ssl/certs/bitese.crt
TLS_KEY_PATH=/etc/ssl/private/bitese.key
TLS_VERIFY=true

# ─────────────────────────────────────────────────────────────────────────────
# SCALABILITY CONFIGURATION (Support 2 Billion+ Users)
# ─────────────────────────────────────────────────────────────────────────────
SHARD_COUNT=256
SHARDING_STRATEGY=consistent_hash
CACHE_TTL_SECONDS=3600
MAX_POOL_SIZE=100
MQ_BATCH_SIZE=1000
MQ_FLUSH_MS=100

# ─────────────────────────────────────────────────────────────────────────────
# CDN CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
CDN_ENABLED=true
CDN_URL=https://cdn.bitese.app
CDN_API_KEY=your_cdn_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# WEBRTC CONFIGURATION (Voice/Video E2EE)
# ─────────────────────────────────────────────────────────────────────────────
WEBRTC_ENABLED=true
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=turn:turnserver.example.com:3478
WEBRTC_TURN_USERNAME=turnuser
WEBRTC_TURN_PASSWORD=turnpassword
WEBRTC_MAX_BW=50
WEBRTC_TIMEOUT=3600

# ─────────────────────────────────────────────────────────────────────────────
# MONETIZATION & PAYMENTS
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_PAYMENTS=true
MONETIZATION_ENABLED=true

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Flutterwave Configuration (For African payments)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash_here

# ─────────────────────────────────────────────────────────────────────────────
# COMMUNICATION APIs
# ─────────────────────────────────────────────────────────────────────────────

# Africa's Talking (SMS, Voice)
AFRICAN_TALKING_USERNAME=your_at_username
AFRICAN_TALKING_API_KEY=your_at_api_key

# ─────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.bitese.com,https://web.bitese.com,https://admin.bitese.com

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_E2EE=true
FEATURE_GROUP_CALLS=true
FEATURE_CHANNELS=true
FEATURE_COMMUNITIES=true
FEATURE_VERIFICATION=true
FEATURE_BUSINESS_API=true

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
ENABLE_METRICS=true
METRICS_INTERVAL_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=BiteSe
APP_VERSION=1.0.0
MAX_CONTENT_LENGTH=52428800  # 50MB
JSON_SORT_KEYS=false
