FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here

# ── Database (PostgreSQL recommended, SQLite fallback for local dev) ───────────
DATABASE_URL=postgresql://user:password@localhost:5432/vipchat

# ── Redis (optional, used for rate limiting) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SMS OTP (Africa's Talking) ────────────────────────────────────────────────
AFRICAN_TALKING_USERNAME=your-african-talking-username
AFRICAN_TALKING_API_KEY=your-african-talking-api-key

# ── Stripe (payment verification & marketplace) ───────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Flutterwave (Africa mobile money payments) ────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-...
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
