# VipChat Docker Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================
MYSQL_ROOT_PASSWORD=YourRootPassword123!
MYSQL_DATABASE=vipchat
MYSQL_USER=vipchat
MYSQL_PASSWORD=YourStrongPassword123!
MYSQL_REPLICATION_PASSWORD=YourReplicationPassword123!

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=YourRedisPassword123!

# ============================================================================
# Flask Application Secrets (CHANGE THESE!)
# ============================================================================
SECRET_KEY=generate-64-random-hex-chars-here-use-openssl-rand-hex-32
JWT_SECRET_KEY=generate-another-64-random-hex-chars-here-use-openssl-rand-hex-32

# ============================================================================
# Stripe Payment Gateway
# ============================================================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# PayPal Payment Gateway
# ============================================================================
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=live

# ============================================================================
# Flutterwave Payment Gateway
# ============================================================================
FLUTTERWAVE_SECRET_KEY=FLWSECK_your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash_here

# ============================================================================
# SMS Provider - Africa's Talking
# ============================================================================
AFRICAN_TALKING_USERNAME=your_username_or_sandbox
AFRICAN_TALKING_API_KEY=your_africas_talking_api_key_here

# ============================================================================
# Web Push Notifications (VAPID)
# ============================================================================
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# ============================================================================
# Application Configuration
# ============================================================================
FLASK_ENV=production
APP_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# Monitoring & Analytics
# ============================================================================
GRAFANA_PASSWORD=YourGrafanaAdminPassword123!

# ============================================================================
# SSL/TLS Configuration (for production)
# ============================================================================
SSL_CERT_EMAIL=admin@yourdomain.com
DOMAIN_NAME=yourdomain.com

# ============================================================================
# Optional Services
# ============================================================================
# AWS S3 for file storage (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Sentry for error tracking (optional)
# SENTRY_DSN=

# Cloudflare (optional)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
